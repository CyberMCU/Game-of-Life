{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/MinGW/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${fileDirname}\\Inc",
                "${fileDirname}\\main.cpp",
                "${fileDirname}\\Src\\cellClass.cpp",
                "${fileDirname}\\Src\\gameClass.cpp",
                "${fileDirname}\\Src\\gridClass.cpp",
                "${fileDirname}\\Src\\mainAppClass.cpp",

                
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:/MinGW/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}